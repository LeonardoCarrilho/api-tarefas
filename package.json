{
  "name": "api-tarefas",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de tarefas com Node.js, Express e MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test tests/*.test.js",
    "test:watch": "node --test --watch",
    "lint": "biome lint .",
    "test:e2e:security": "playwright test"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "mongodb",
    "mongoose",
    "nodejs"
  ],
  "author": "Leonardo Fernandes Carrilho",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
