{
  "name": "api-tarefas",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de tarefas com Node.js, Express e MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-reporter=spec",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "mongodb",
    "mongoose",
    "nodejs"
  ],
  "author": "Leonardo Fernandes Carrilho",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
