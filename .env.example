# Porta do servidor
PORT=3000

# Conexão local
MONGODB_URI=mongodb://127.0.0.1:27017/api-tarefas

# Use "production" em produção
NODE_ENV=development

# Origem permitida no CORS (opcional; vazio libera todas)
CORS_ORIGIN=

# Rate limit das rotas /api/tasks (opcional; padrão: 100 req por minuto)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
