# Porta do servidor
PORT=3000

# Conexão local
MONGODB_URI=mongodb://127.0.0.1:27017/api-tarefas

# Use "production" em produção
NODE_ENV=development

# Origem permitida no CORS (opcional; vazio libera todas)
CORS_ORIGIN=

# Rate limit das rotas /api/tasks (opcional; padrão: 100 req por minuto)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Obrigatórios em produção. Proxy deve remover headers encaminhados do cliente.
PUBLIC_ORIGIN=https://api.example.com
TRUSTED_PROXIES=
# Ativar depois no serviço, sem versionar o valor real.
SENTRY_DSN=
APP_RELEASE=

# Somente servidor-servidor; nunca colocar no frontend.
TASK_API_TOKEN=
